####
# Dockerfile for Quarkus fast-jar (Gradle build)
#
# Build locally:
#   ./gradlew clean build -x test
#   docker build -f src/main/docker/Dockerfile.jvm -t uda-server .
#
# Run locally:
#   docker run -i --rm -p 8080:8080 uda-server
#
# This image expects the Gradle fast-jar layout at build/quarkus-app/
####
FROM eclipse-temurin:17-jre-alpine

RUN addgroup -S app && adduser -S -G app -u 185 app \
    && mkdir -p /deployments \
    && chown -R app:app /deployments

WORKDIR /deployments

COPY --chown=app:app build/quarkus-app/lib/ /deployments/lib/
COPY --chown=app:app build/quarkus-app/*.jar /deployments/
COPY --chown=app:app build/quarkus-app/app/ /deployments/app/
COPY --chown=app:app build/quarkus-app/quarkus/ /deployments/quarkus/

USER 185
EXPOSE 8080

ENV LANG=C.UTF-8 \
    JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager" \
    JAVA_APP_JAR="/deployments/quarkus-run.jar"

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/q/health/ready >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/bin/sh", "-c", "exec java $JAVA_OPTS -jar $JAVA_APP_JAR"]
